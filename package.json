{
  "name": "bean-noticing-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:backend": "node scripts/test-supabase.mjs",
    "verify": "npm run build",
    "deploy:web": "npm run build && wrangler pages deploy dist --project-name bean-app",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@supabase/supabase-js": "^2.110.0",
    "motion": "12.23.24",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.12",
    "tw-animate-css": "1.3.8",
    "typescript": "latest",
    "vite": "7.3.6",
    "wrangler": "^4.114.0"
  }
}
